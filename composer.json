{
    "name": "clicktrail/php-sdk",
    "description": "ClickTrail deterministic attribution core and PHP SDK - parse, classify and merge first/last-touch attribution; event ingestion contracts.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ClickTrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClickTrail\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Vizuh OU",
            "email": "hugo@vizuh.com"
        }
    ],
    "keywords": [
        "attribution",
        "analytics",
        "first-party",
        "marketing",
        "utm",
        "gclid"
    ],
    "support": {
        "issues": "https://github.com/vizuh/clicktrail-php/issues",
        "source": "https://github.com/vizuh/clicktrail-php"
    }
}